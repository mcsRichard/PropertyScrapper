/* pages/detail/detail.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.loading, .empty {
  text-align: center;
  padding: 100rpx;
  color: #999;
  font-size: 28rpx;
}

.property-detail {
  padding-bottom: 40rpx;
}

.detail-swiper-wrapper {
  width: 100%;
  height: 500rpx;
  background-color: #f0f0f0;
  position: relative;
}

.detail-swiper {
  width: 100%;
  height: 100%;
}

.swiper-item {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-image {
  width: 100%;
  height: 100%;
  background-color: #f0f0f0;
  display: block;
}

.image-counter {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  z-index: 10;
}

/* 左右箭头按钮 */
.swiper-arrows {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 5;
}

.arrow-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 80rpx;
  height: 80rpx;
  background-color: rgba(0, 0, 0, 0.4);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
  transition: background-color 0.3s;
}

.arrow-btn:active {
  background-color: rgba(0, 0, 0, 0.6);
}

.arrow-left {
  left: 20rpx;
}

.arrow-right {
  right: 20rpx;
}

.arrow-icon {
  color: #fff;
  font-size: 60rpx;
  font-weight: bold;
  line-height: 1;
  margin-top: -8rpx;
}

.detail-image-placeholder {
  width: 100%;
  height: 500rpx;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-text {
  color: #999;
  font-size: 28rpx;
}

.detail-section {
  background-color: #fff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
}

.contact-card {
  border: 2rpx solid rgba(200, 16, 46, 0.1);
  box-shadow: 0 8rpx 24rpx rgba(1, 33, 105, 0.08);
}

.contact-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.contact-title .quota {
  font-size: 26rpx;
  color: #666;
}

.contact-btn {
  width: 100%;
  height: 90rpx;
  border-radius: 45rpx;
  background: linear-gradient(135deg, #C8102E 0%, #012169 100%);
  color: #fff;
  font-size: 30rpx;
  margin-top: 20rpx;
  line-height: 90rpx;
}

.contact-btn::after {
  border: none;
}

.contact-btn[disabled] {
  background: #ccc;
  color: #666;
}

.contact-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.contact-login {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.contact-login-btn {
  width: 100%;
  height: 90rpx;
  border-radius: 45rpx;
  background: #fff;
  color: #C8102E;
  border: 2rpx solid #C8102E;
  line-height: 88rpx;
}

.contact-login-btn::after {
  border: none;
}

.detail-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.detail-price {
  font-size: 48rpx;
  font-weight: bold;
  color: #f40;
  margin-bottom: 30rpx;
}

.detail-meta {
  display: flex;
  flex-wrap: wrap;
}

.meta-item {
  width: 50%;
  margin-bottom: 20rpx;
}

.meta-label {
  display: inline-block;
  font-size: 26rpx;
  color: #999;
  margin-right: 10rpx;
}

.meta-value {
  font-size: 28rpx;
  color: #333;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.description-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.action-buttons {
  padding: 40rpx 20rpx;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  background-color: #3cc51f;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  line-height: 88rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.customer-service-card {
  background-color: #fff;
  margin: 0 20rpx 30rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.card-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.wechat-info {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
}

.wechat-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 12rpx;
}

.wechat-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-right: 20rpx;
}

.copy-wechat-btn {
  margin-left: auto;
  font-size: 24rpx;
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 28rpx;
}

.copy-wechat-btn::after {
  border: none;
}

.qr-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.qr-image {
  width: 320rpx;
  height: 320rpx;
  background-color: #f5f5f5;
  border-radius: 16rpx;
}

.qr-tip {
  font-size: 24rpx;
  color: #999;
}
