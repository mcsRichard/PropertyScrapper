<!--pages/detail/detail.wxml-->
<view class="container">
  <view wx:if="{{loading}}" class="loading">加载中...</view>
  
  <view wx:if="{{!loading && property}}" class="property-detail">
    <!-- 图片轮播 -->
    <view class="detail-swiper-wrapper" wx:if="{{property.imageUrls && property.imageUrls.length > 0}}">
      <swiper 
        class="detail-swiper" 
        indicator-dots="{{true}}" 
        indicator-color="rgba(255,255,255,0.5)"
        indicator-active-color="#fff"
        autoplay="{{false}}" 
        circular="{{true}}"
        interval="5000"
        duration="500"
        bindchange="onSwiperChange">
        <block wx:for="{{property.imageUrls}}" wx:key="index" wx:for-item="imgUrl">
          <swiper-item class="swiper-item">
            <image 
              class="detail-image" 
              src="{{imgUrl}}" 
              mode="aspectFill" 
              bindtap="previewImage" 
              binderror="onImageError"
              data-index="{{index}}"
              lazy-load="{{false}}" />
          </swiper-item>
        </block>
      </swiper>
      <!-- 图片计数器 -->
      <view class="image-counter" wx:if="{{property.imageUrls && property.imageUrls.length > 1}}">
        <text>{{currentImageIndex + 1}} / {{property.imageUrls.length}}</text>
      </view>
    </view>
    
    <!-- 如果没有任何图片，显示占位图 -->
    <view class="detail-swiper-wrapper" wx:if="{{!property.imageUrls || property.imageUrls.length === 0}}">
      <view class="detail-image-placeholder">
        <text class="placeholder-text">暂无图片</text>
      </view>
    </view>
    
    <!-- 基本信息 -->
    <view class="detail-section">
      <view class="detail-title">{{property.title}}</view>
      <view class="detail-price">{{property.price}}</view>
      
      <view class="detail-meta">
        <view wx:if="{{property.bedrooms}}" class="meta-item">
          <text class="meta-label">卧室</text>
          <text class="meta-value">{{property.bedrooms}}室</text>
        </view>
        <view wx:if="{{property.property_type}}" class="meta-item">
          <text class="meta-label">类型</text>
          <text class="meta-value">{{property.property_type}}</text>
        </view>
        <view wx:if="{{property.area}}" class="meta-item">
          <text class="meta-label">面积</text>
          <text class="meta-value">{{property.area}}</text>
        </view>
      </view>
    </view>

    <!-- 详细信息 -->
    <view class="detail-section">
      <view class="section-title">房产描述</view>
      <view class="description-text">{{property.description_chinese}}</view>
    </view>

    <!-- 详细信息(英文) -->
    <view class="detail-section">
      <view class="section-title">Property Description</view>
      <view class="description-text">{{property.description}}</view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-buttons">
      <button class="btn-primary" bindtap="viewOriginalLink">查看原网页</button>
    </view>
  </view>
  
  <view wx:if="{{!loading && !property}}" class="empty">
    加载失败，请重试
  </view>
</view>
