<!--pages/detail/detail.wxml-->
<view class="container">
  <view wx:if="{{loading}}" class="loading">加载中...</view>
  
  <view wx:if="{{!loading && property}}" class="property-detail">
    <!-- 图片轮播 -->
    <view class="detail-swiper-wrapper" wx:if="{{property.imageUrls && property.imageUrls.length > 0}}">
      <swiper 
        id="detail-swiper"
        class="detail-swiper" 
        current="{{currentImageIndex}}"
        indicator-dots="{{true}}" 
        indicator-color="rgba(255,255,255,0.5)"
        indicator-active-color="#fff"
        autoplay="{{false}}" 
        circular="{{true}}"
        interval="5000"
        duration="500"
        bindchange="onSwiperChange">
        <block wx:for="{{property.imageUrls}}" wx:key="index" wx:for-item="imgUrl">
          <swiper-item class="swiper-item">
            <image 
              class="detail-image" 
              src="{{imgUrl}}" 
              mode="aspectFill" 
              bindtap="previewImage" 
              binderror="onImageError"
              data-index="{{index}}"
              lazy-load="{{false}}" />
          </swiper-item>
        </block>
      </swiper>
      <!-- 左右箭头按钮 -->
      <view class="swiper-arrows" wx:if="{{property.imageUrls && property.imageUrls.length > 1}}">
        <view class="arrow-btn arrow-left" bindtap="onPrevImage">
          <text class="arrow-icon">‹</text>
        </view>
        <view class="arrow-btn arrow-right" bindtap="onNextImage">
          <text class="arrow-icon">›</text>
        </view>
      </view>
      <!-- 图片计数器 -->
      <view class="image-counter" wx:if="{{property.imageUrls && property.imageUrls.length > 1}}">
        <text>{{currentImageIndex + 1}} / {{property.imageUrls.length}}</text>
      </view>
    </view>
    
    <!-- 如果没有任何图片，显示占位图 -->
    <view class="detail-swiper-wrapper" wx:if="{{!property.imageUrls || property.imageUrls.length === 0}}">
      <view class="detail-image-placeholder">
        <text class="placeholder-text">暂无图片</text>
      </view>
    </view>
    
    <!-- 基本信息 -->
    <view class="detail-section">
      <view class="detail-title">{{property.title}}</view>
      <view class="detail-price">{{property.price}}</view>
      
      <view class="detail-meta">
        <view wx:if="{{property.bedrooms}}" class="meta-item">
          <text class="meta-label">卧室</text>
          <text class="meta-value">{{property.bedrooms}}室</text>
        </view>
        <view wx:if="{{property.property_type}}" class="meta-item">
          <text class="meta-label">类型</text>
          <text class="meta-value">{{property.property_type}}</text>
        </view>
        <view wx:if="{{property.area}}" class="meta-item">
          <text class="meta-label">面积</text>
          <text class="meta-value">{{property.area}}</text>
        </view>
      </view>
    </view>

    <!-- 详细信息 -->
    <view class="detail-section">
      <view class="section-title">房产描述</view>
      <view class="description-text">{{property.description_chinese}}</view>
    </view>

    <!-- 联系中介 -->
    <view class="detail-section contact-card">
      <view class="section-title contact-title">
        联系中介
        <text class="quota" wx:if="{{isLoggedIn}}">
          今日剩余 {{contactStats ? contactStats.remaining : 0}} / {{contactStats ? contactStats.limit : 5}}
        </text>
      </view>
      <view wx:if="{{isLoggedIn}}">
        <button 
          class="contact-btn" 
          bindtap="handleContactAgent" 
          loading="{{contactLoading}}"
          disabled="{{contactLoading || (contactStats && contactStats.remaining <= 0)}}">
          {{contactStats && contactStats.remaining <= 0 ? '今日额度已用完' : '联系中介'}}
        </button>
        <view class="contact-tip">点击后小程序会自动复制房产原链接，请粘贴到浏览器打开即可联系中介/房东</view>
      </view>
      <view wx:else class="contact-login">
        <text class="login-tip">登录后可复制房源链接，在浏览器中打开联系中介</text>
        <button class="contact-login-btn" bindtap="onLoginTap">微信登录</button>
      </view>
    </view>

    <!-- 客服微信二维码 -->
    <view class="customer-service-card" wx:if="{{customerService.wechatId || customerService.qrUrl}}">
      <view class="card-title">客服微信</view>
      <view class="card-content">
        <view class="wechat-info" wx:if="{{customerService.wechatId}}">
          <text class="wechat-label">微信号：</text>
          <text class="wechat-value">{{customerService.wechatId}}</text>
          <button class="copy-wechat-btn" size="mini" bindtap="copyCustomerWechat">复制</button>
        </view>
        <view class="qr-section" wx:if="{{customerService.qrUrl}}">
          <image 
            class="qr-image" 
            src="{{customerService.qrUrl}}" 
            mode="aspectFit" 
            bindtap="previewCustomerServiceQr"
            show-menu-by-longpress="true"
          />
          <view class="qr-tip">长按识别二维码，或点击放大查看</view>
        </view>
      </view>
    </view>
  </view>
  
  <view wx:if="{{!loading && !property}}" class="empty">
    加载失败，请重试
  </view>
</view>
