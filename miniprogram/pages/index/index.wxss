/* pages/index/index.wxss */
/* 英伦风格配色 - 皇家蓝 #012169, 国旗红 #C8102E, 金色 #D4AF37, 米色 #F5E6D3 */

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #F8F6F0 0%, #FFFEF7 100%);
  overflow: hidden; /* 防止内容溢出 */
  position: relative; /* 确保定位上下文正确 */
}

/* Logo Header - 英伦风格 */
.logo-header {
  background: linear-gradient(135deg, #012169 0%, #00308F 50%, #C8102E 100%);
  padding: 30rpx 30rpx 25rpx;
  box-shadow: 0 4rpx 20rpx rgba(1, 33, 105, 0.3);
  position: relative;
  overflow: hidden;
}

.logo-header::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(45deg, transparent 30%, rgba(255, 255, 255, 0.1) 50%, transparent 70%);
  pointer-events: none;
}

.header-content {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}

.uk-icon {
  margin-right: 20rpx;
}

.icon-bg {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(245, 230, 211, 0.95) 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.8);
  border: 3rpx solid rgba(212, 175, 55, 0.6);
  position: relative;
}

.icon-bg::after {
  content: '';
  position: absolute;
  top: -2rpx;
  left: -2rpx;
  right: -2rpx;
  bottom: -2rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.4), rgba(200, 16, 46, 0.4));
  z-index: -1;
}

.logo-text {
  flex: 1;
}

.logo-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #FFFFFF;
  letter-spacing: 3rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.logo-subtitle {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

.ai-badge {
  position: absolute;
  top: 20rpx;
  right: 30rpx;
  background: linear-gradient(135deg, #D4AF37 0%, #F5E6D3 100%);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(212, 175, 55, 0.4);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.ai-badge-text {
  font-size: 20rpx;
  color: #012169;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.user-status {
  margin-top: 20rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
}

.user-avatar-wrapper {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-avatar {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 36rpx;
  color: #fff;
}

.user-text {
  display: flex;
  flex-direction: column;
  color: #fff;
}

.user-name {
  font-size: 28rpx;
  font-weight: 600;
}

.user-quota {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 6rpx;
}

.login-btn-mini {
  flex: 1;
  font-size: 26rpx;
  color: #012169;
  background: #fff;
  border-radius: 30rpx;
  padding: 0 24rpx;
  height: 70rpx;
  line-height: 70rpx;
}

.login-btn-mini::after {
  border: none;
}

/* AI搜索区域 - 突出显示 */
.ai-search-section {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.95) 0%, rgba(248, 246, 240, 0.9) 100%);
  padding: 30rpx 20rpx;
  margin: 20rpx 20rpx 25rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(1, 33, 105, 0.15);
  border: 2rpx solid rgba(212, 175, 55, 0.3);
  position: relative;
  z-index: 1; /* 确保在正常文档流中，不会遮挡其他内容 */
}

.ai-search-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #012169 0%, #C8102E 50%, #D4AF37 100%);
  border-radius: 24rpx 24rpx 0 0;
  z-index: 0; /* 确保装饰条在最底层 */
  pointer-events: none; /* 不影响点击 */
}

.ai-search-header {
  display: flex;
  align-items: center;
  margin-bottom: 25rpx;
}

.ai-icon-wrapper {
  position: relative;
  margin-right: 20rpx;
  z-index: 1; /* 确保图标在正常层级 */
}

.ai-icon {
  font-size: 48rpx;
  display: block;
  position: relative;
  z-index: 2;
}

.ai-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 60rpx;
  height: 60rpx;
  background: radial-gradient(circle, rgba(200, 16, 46, 0.4) 0%, rgba(212, 175, 55, 0.2) 50%, transparent 80%);
  border-radius: 50%;
  z-index: 1;
  pointer-events: none; /* 确保光晕不影响点击 */
}

.ai-search-title {
  flex: 1;
}

.ai-title-main {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #012169;
  margin-bottom: 6rpx;
  letter-spacing: 1rpx;
}

.ai-title-sub {
  display: block;
  font-size: 22rpx;
  color: #666;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.search-input-wrapper {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FFFFFF 0%, #F8F6F0 100%);
  border-radius: 40rpx;
  padding: 0 25rpx;
  height: 88rpx;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.05), 0 4rpx 16rpx rgba(1, 33, 105, 0.1);
  border: 2rpx solid rgba(212, 175, 55, 0.2);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 100%;
}

.ai-search-btn {
  width: 160rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #C8102E 0%, #E63946 100%);
  color: #fff;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: bold;
  box-shadow: 0 6rpx 20rpx rgba(200, 16, 46, 0.4), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.3);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  position: relative;
  overflow: hidden;
}

.ai-search-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  transition: left 0.5s;
}

.ai-search-btn:active::before {
  left: 100%;
}

.btn-text {
  font-size: 26rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.btn-icon {
  font-size: 28rpx;
}

/* AI筛选提示 - 高科技风格 */
.ai-filter-tip {
  margin-top: 20rpx;
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.1) 0%, rgba(200, 16, 46, 0.05) 100%);
  border-radius: 16rpx;
  padding: 20rpx;
  border: 2rpx solid rgba(212, 175, 55, 0.3);
  box-shadow: 0 4rpx 16rpx rgba(212, 175, 55, 0.15);
  position: relative;
  overflow: hidden;
}

.ai-filter-tip::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: linear-gradient(180deg, #D4AF37 0%, #C8102E 100%);
}

.tip-content {
  display: flex;
  align-items: center;
}

.tip-icon-wrapper {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #D4AF37 0%, #F5E6D3 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(212, 175, 55, 0.3);
}

.tip-icon {
  font-size: 32rpx;
}

.tip-text-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.tip-label {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #012169;
  font-weight: 600;
}

.filter-bar {
  display: flex;
  flex-direction: column;
  padding: 24rpx 20rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #F8F6F0 100%);
  margin: 0 20rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(1, 33, 105, 0.08);
  border: 1rpx solid rgba(212, 175, 55, 0.2);
  position: relative;
  z-index: 1; /* 确保在正常层级 */
}

/* 筛选栏头部 */
.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.filter-toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: linear-gradient(135deg, rgba(1, 33, 105, 0.1) 0%, rgba(200, 16, 46, 0.1) 100%);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
  border: 1rpx solid rgba(212, 175, 55, 0.3);
  cursor: pointer;
}

.filter-toggle-text {
  font-size: 24rpx;
  color: #333;
}

.filter-toggle-icon {
  font-size: 20rpx;
  color: #012169;
}

.listing-type-tabs {
  display: flex;
  flex: 1;
  background: linear-gradient(135deg, rgba(1, 33, 105, 0.08) 0%, rgba(200, 16, 46, 0.05) 100%);
  border-radius: 32rpx;
  padding: 6rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.2);
}

.tab-item {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 12rpx 0;
  border-radius: 28rpx;
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.tab-item.active {
  background: linear-gradient(135deg, #012169 0%, #00308F 50%, #C8102E 100%);
  color: #fff;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(1, 33, 105, 0.3), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.2);
}

.clear-btn {
  width: 100%;
  height: 72rpx;
  background: linear-gradient(135deg, rgba(200, 16, 46, 0.1) 0%, rgba(1, 33, 105, 0.1) 100%);
  color: #C8102E;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: 2rpx solid rgba(200, 16, 46, 0.3);
  box-shadow: 0 2rpx 8rpx rgba(200, 16, 46, 0.15);
  transition: all 0.3s;
}

.clear-btn:active {
  background: linear-gradient(135deg, rgba(200, 16, 46, 0.2) 0%, rgba(1, 33, 105, 0.15) 100%);
  transform: scale(0.98);
}

/* 筛选器分组 */
.filter-groups {
  width: 100%;
  margin-top: 20rpx;
  max-height: 2000rpx;
  overflow: hidden;
  transition: max-height 0.3s ease-out, opacity 0.3s ease-out;
  opacity: 1;
}

.filter-groups.collapsed {
  max-height: 0;
  margin-top: 0;
  opacity: 0;
  overflow: hidden;
}

.filter-group {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(212, 175, 55, 0.15);
}

.filter-group:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.filter-group-label {
  display: flex;
  align-items: center;
  min-width: 160rpx;
  margin-right: 20rpx;
}

.filter-group-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.filter-group-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.filter-group-options {
  flex: 1;
  display: flex;
  align-items: center;
}

.filter-option {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 24rpx;
  background: linear-gradient(135deg, rgba(248, 246, 240, 0.6) 0%, #FFFFFF 100%);
  border-radius: 16rpx;
  font-size: 28rpx;
  border: 2rpx solid rgba(212, 175, 55, 0.2);
  color: #666;
  font-weight: 500;
  transition: all 0.3s;
  min-height: 64rpx;
  cursor: pointer;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
}

.price-filter-btn {
  cursor: pointer;
}

.filter-option.active {
  background: linear-gradient(135deg, #012169 0%, #00308F 50%, #C8102E 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(1, 33, 105, 0.25), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.2);
  border-color: rgba(212, 175, 55, 0.5);
  font-weight: 600;
}

.filter-arrow {
  font-size: 20rpx;
  opacity: 0.6;
  margin-left: 12rpx;
}

.filter-option.active .filter-arrow {
  opacity: 0.9;
}

/* 筛选操作按钮区域 */
.filter-actions {
  width: 100%;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(212, 175, 55, 0.15);
}

/* 筛选操作按钮区域 - 头部位置 */
.filter-actions-header {
  width: 100%;
  margin-top: 15rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid rgba(212, 175, 55, 0.15);
}

.filter-panel {
  background-color: #fff;
  padding: 30rpx;
  margin: 0 20rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
  position: relative;
  z-index: 10;
  border: 2rpx solid rgba(212, 175, 55, 0.2);
}

.filter-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

/* 价格预设选项 */
.price-presets {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin-bottom: 30rpx;
}

.price-preset-item {
  flex: 1;
  min-width: 140rpx;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 15rpx;
  text-align: center;
  font-size: 26rpx;
  color: #333;
  transition: all 0.3s;
}

.price-preset-item.selected {
  background: linear-gradient(135deg, #C8102E 0%, #012169 100%);
  color: #fff;
  box-shadow: 0 4rpx 8rpx rgba(200, 16, 46, 0.2);
}

/* 手动输入价格 */
.manual-price-input {
  margin-bottom: 30rpx;
}

.input-group {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}

.input-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.price-input {
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.price-display {
  text-align: center;
  font-size: 32rpx;
  color: #C8102E;
  font-weight: bold;
  padding: 20rpx;
  background: linear-gradient(135deg, #FFF5F5 0%, #F0F4FF 100%);
  border-radius: 10rpx;
  margin-bottom: 30rpx;
  border: 2rpx solid #C8102E;
}

.filter-actions {
  display: flex;
  gap: 20rpx;
}

.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #C8102E 0%, #012169 100%);
  color: #fff;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 10rpx rgba(200, 16, 46, 0.3);
}

.btn-secondary {
  flex: 1;
  background-color: #f5f5f5;
  color: #666;
  border-radius: 30rpx;
}

.property-list {
  flex: 1;
  padding: 20rpx;
  position: relative;
  z-index: 1; /* 确保列表在正常层级 */
  overflow-y: auto; /* 确保可以滚动 */
}

.property-item {
  display: flex;
  background: linear-gradient(135deg, #FFFFFF 0%, #F8F6F0 100%);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(1, 33, 105, 0.12), 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s;
  border: 1rpx solid rgba(212, 175, 55, 0.15);
  position: relative;
}

.property-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #012169 0%, #C8102E 50%, #D4AF37 100%);
  opacity: 0;
  transition: opacity 0.3s;
}

.property-item:active {
  transform: scale(0.98) translateY(2rpx);
  box-shadow: 0 4rpx 16rpx rgba(1, 33, 105, 0.15), 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
}

.property-item:active::before {
  opacity: 1;
}

.property-image {
  width: 200rpx;
  height: 200rpx;
  background-color: #f0f0f0;
}

.property-info {
  flex: 1;
  padding: 20rpx;
}

.property-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.property-price {
  font-size: 38rpx;
  color: #C8102E;
  font-weight: bold;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 4rpx rgba(200, 16, 46, 0.1);
}

.property-meta {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.property-meta text {
  margin-right: 20rpx;
}

.property-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.loading, .no-more, .empty {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}
