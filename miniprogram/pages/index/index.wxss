/* pages/index/index.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #F8F8F8;
}

/* Logo Header */
.logo-header {
  display: flex;
  align-items: center;
  padding: 30rpx 40rpx 20rpx;
  background: linear-gradient(135deg, #C8102E 0%, #012169 100%);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.uk-icon {
  margin-right: 20rpx;
}

.icon-bg {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.85) 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  box-shadow: 0 6rpx 16rpx rgba(200, 16, 46, 0.15), inset 0 1rpx 3rpx rgba(1, 33, 105, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
}

.logo-text {
  flex: 1;
}

.logo-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.logo-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 5rpx;
}

.search-bar {
  display: flex;
  padding: 20rpx;
  background-color: #fff;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.search-input {
  flex: 1;
  height: 70rpx;
  background-color: #F5F5F5;
  border-radius: 35rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}

.search-btn {
  width: 140rpx;
  height: 70rpx;
  background: linear-gradient(135deg, #C8102E 0%, #012169 100%);
  color: #fff;
  border-radius: 35rpx;
  margin-left: 20rpx;
  font-size: 26rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 10rpx rgba(200, 16, 46, 0.3);
}

.filter-bar {
  display: flex;
  padding: 20rpx;
  background-color: #fff;
  margin-bottom: 20rpx;
  align-items: center;
  flex-wrap: wrap;
}

.listing-type-tabs {
  display: flex;
  width: 100%;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  padding: 4rpx;
  margin-bottom: 15rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 10rpx 0;
  border-radius: 26rpx;
  transition: all 0.3s;
  font-size: 28rpx;
  color: #666;
}

.tab-item.active {
  background: linear-gradient(135deg, #C8102E 0%, #012169 100%);
  color: #fff;
  font-weight: bold;
  box-shadow: 0 4rpx 8rpx rgba(200, 16, 46, 0.2);
}

.filter-btn, .clear-btn {
  height: 60rpx;
  padding: 0 30rpx;
  background: linear-gradient(135deg, #C8102E 0%, #012169 100%);
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  margin-right: 10rpx;
  box-shadow: 0 4rpx 10rpx rgba(200, 16, 46, 0.3);
}

.clear-btn {
  background-color: #ff6b6b;
}

/* 筛选按钮组 */
.filter-buttons {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  width: 100%;
  margin-top: 15rpx;
  gap: 15rpx;
}

.filter-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 10rpx;
}

.filter-item {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 12rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 20rpx;
  font-size: 26rpx;
  min-width: 120rpx;
  transition: all 0.3s;
}

.filter-item.active {
  background: linear-gradient(135deg, #C8102E 0%, #012169 100%);
  color: #fff;
  box-shadow: 0 4rpx 10rpx rgba(200, 16, 46, 0.2);
}

.filter-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.filter-panel {
  background-color: #fff;
  padding: 30rpx;
  margin: 0 20rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
}

.filter-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

/* 价格预设选项 */
.price-presets {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin-bottom: 30rpx;
}

.price-preset-item {
  flex: 1;
  min-width: 140rpx;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 15rpx;
  text-align: center;
  font-size: 26rpx;
  color: #333;
  transition: all 0.3s;
}

.price-preset-item.selected {
  background: linear-gradient(135deg, #C8102E 0%, #012169 100%);
  color: #fff;
  box-shadow: 0 4rpx 8rpx rgba(200, 16, 46, 0.2);
}

/* 手动输入价格 */
.manual-price-input {
  margin-bottom: 30rpx;
}

.input-group {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}

.input-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.price-input {
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.price-display {
  text-align: center;
  font-size: 32rpx;
  color: #C8102E;
  font-weight: bold;
  padding: 20rpx;
  background: linear-gradient(135deg, #FFF5F5 0%, #F0F4FF 100%);
  border-radius: 10rpx;
  margin-bottom: 30rpx;
  border: 2rpx solid #C8102E;
}

.filter-actions {
  display: flex;
  gap: 20rpx;
}

.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #C8102E 0%, #012169 100%);
  color: #fff;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 10rpx rgba(200, 16, 46, 0.3);
}

.btn-secondary {
  flex: 1;
  background-color: #f5f5f5;
  color: #666;
  border-radius: 30rpx;
}

.property-list {
  flex: 1;
  padding: 20rpx;
}

.property-item {
  display: flex;
  background-color: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.property-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}

.property-image {
  width: 200rpx;
  height: 200rpx;
  background-color: #f0f0f0;
}

.property-info {
  flex: 1;
  padding: 20rpx;
}

.property-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.property-price {
  font-size: 36rpx;
  color: #C8102E;
  font-weight: bold;
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}

.property-meta {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.property-meta text {
  margin-right: 20rpx;
}

.property-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.loading, .no-more, .empty {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}
