<!--pages/index/index.wxml-->
<view class="container">
  <!-- Logo Header -->
  <view class="logo-header">
    <view class="header-content">
      <view class="uk-icon">
        <view class="icon-bg">👑</view>
      </view>
      <view class="logo-text">
        <view class="logo-title">UK Property</view>
        <view class="logo-subtitle">AI智能房产搜索</view>
      </view>
    </view>
    <view class="ai-badge">
      <text class="ai-badge-text">AI Powered</text>
    </view>
  <view class="user-status">
    <view wx:if="{{isLoggedIn}}" class="user-info">
      <view class="user-avatar-wrapper">
        <image 
          wx:if="{{userInfo && (userInfo.avatarUrl || userInfo.avatar_url)}}" 
          class="user-avatar" 
          src="{{userInfo.avatarUrl || userInfo.avatar_url}}" 
          mode="aspectFill" />
        <view wx:else class="avatar-placeholder">😊</view>
      </view>
      <view class="user-text">
        <text class="user-name">
          {{userInfo && (userInfo.nickName || userInfo.nickname) ? (userInfo.nickName || userInfo.nickname) : '已登录'}}
        </text>
        <text class="user-quota">
          今日联系剩余 {{contactStats ? contactStats.remaining : 5}} / {{contactStats ? contactStats.limit : 5}}
        </text>
      </view>
      <view class="logout-btn" bindtap="handleLogoutTap">
        <text>退出</text>
      </view>
    </view>
    <button wx:else class="login-btn-mini" bindtap="handleLoginTap" loading="{{loginInProgress}}">
      微信登录
    </button>
  </view>
  </view>
  
  <!-- AI对话搜索栏 - 突出显示 -->
  <view class="ai-search-section">
    <view class="ai-search-header">
      <view class="ai-icon-wrapper">
        <text class="ai-icon">🤖</text>
        <view class="ai-glow"></view>
      </view>
      <view class="ai-search-title">
        <text class="ai-title-main">AI智能搜索</text>
        <text class="ai-title-sub">用自然语言描述您想要的房产</text>
      </view>
    </view>
    
    <view class="search-bar">
      <view class="search-input-wrapper">
        <text class="search-icon">🔍</text>
        <input class="search-input" placeholder="例如：帝国理工大学附近2室一厅公寓4000镑以下" bindinput="onSearchInput" value="{{searchKeyword}}" />
      </view>
      <button class="ai-search-btn" bindtap="onAISearch">
        <text class="btn-text">AI搜索</text>
        <text class="btn-icon">⚡</text>
      </button>
    </view>
    
    <!-- AI解析结果提示 -->
    <view class="ai-filter-tip" wx:if="{{aiFilters && searchKeyword}}">
      <view class="ai-generated-badge">
        <text class="ai-generated-text">🤖 AI生成</text>
      </view>
      <view class="tip-content">
        <view class="tip-icon-wrapper">
          <text class="tip-icon">✨</text>
        </view>
        <view class="tip-text-wrapper">
          <text class="tip-label">AI已为您解析搜索条件</text>
          <text class="tip-text">{{aiFiltersText}}</text>
        </view>
      </view>
      <view class="ai-disclaimer">
        <text class="ai-disclaimer-text">以上搜索条件由AI生成，仅供参考</text>
      </view>
    </view>
  </view>

  <!-- 筛选栏 -->
  <view class="filter-bar">
    <!-- 筛选栏头部：类型切换 + 展开/收起按钮 -->
    <view class="filter-header">
      <!-- 房产类型切换 -->
      <view class="listing-type-tabs">
        <view class="tab-item {{listingType === 'for_sale' ? 'active' : ''}}" bindtap="onListingTypeChange" data-type="for_sale">
          <text>出售</text>
        </view>
        <view class="tab-item {{listingType === 'for_rent' ? 'active' : ''}}" bindtap="onListingTypeChange" data-type="for_rent">
          <text>出租</text>
        </view>
      </view>
      
      <!-- 展开/收起按钮 -->
      <view class="filter-toggle" bindtap="toggleFilter">
        <text class="filter-toggle-text">{{filterExpanded ? '收起' : '展开筛选'}}</text>
        <text class="filter-toggle-icon">{{filterExpanded ? '▲' : '▼'}}</text>
      </view>
    </view>
    
    <!-- 筛选器分组 -->
    <view class="filter-groups {{filterExpanded ? '' : 'collapsed'}}">
      <!-- 卧室数量筛选 -->
      <view class="filter-group">
        <view class="filter-group-label">
          <text class="filter-group-icon">🛏</text>
          <text class="filter-group-text">卧室数量</text>
        </view>
        <view class="filter-group-options">
          <picker mode="selector" range="{{bedroomOptions}}" range-key="label" bindchange="onBedroomChange">
            <view class="filter-option {{currentBedroom !== '不限' ? 'active' : ''}}">
              <text>{{currentBedroom || '不限'}}</text>
              <text class="filter-arrow">▼</text>
            </view>
          </picker>
        </view>
      </view>
      
      <!-- 房产类型筛选 -->
      <view class="filter-group">
        <view class="filter-group-label">
          <text class="filter-group-icon">🏠</text>
          <text class="filter-group-text">房产类型</text>
        </view>
        <view class="filter-group-options">
          <picker mode="selector" range="{{typeOptions}}" range-key="label" bindchange="onTypeChange">
            <view class="filter-option {{currentType !== '不限' ? 'active' : ''}}">
              <text>{{currentType || '不限'}}</text>
              <text class="filter-arrow">▼</text>
            </view>
          </picker>
        </view>
      </view>
      
      <!-- 价格范围筛选 -->
      <view class="filter-group">
        <view class="filter-group-label">
          <text class="filter-group-icon">💰</text>
          <text class="filter-group-text">价格范围</text>
        </view>
        <view class="filter-group-options">
          <picker mode="selector" range="{{priceOptions}}" range-key="label" bindchange="onPriceChange">
            <view class="filter-option {{currentPrice !== '不限' ? 'active' : ''}}">
              <text>{{currentPrice || '不限'}}</text>
              <text class="filter-arrow">▼</text>
            </view>
          </picker>
        </view>
      </view>
      
      <!-- 排序方式筛选 -->
      <view class="filter-group">
        <view class="filter-group-label">
          <text class="filter-group-icon">🔀</text>
          <text class="filter-group-text">排序方式</text>
        </view>
        <view class="filter-group-options">
          <picker mode="selector" range="{{sortOptions}}" range-key="label" bindchange="onSortChange">
            <view class="filter-option {{currentSort !== '默认' ? 'active' : ''}}">
              <text>{{currentSort || '默认'}}</text>
              <text class="filter-arrow">▼</text>
            </view>
          </picker>
        </view>
      </view>
    </view>
    
    <!-- 清除筛选按钮 - 始终显示在头部（如果有筛选条件） -->
    <view class="filter-actions-header" wx:if="{{filters.minPrice || filters.maxPrice || filters.propertyType || filters.bedrooms || currentSort !== '默认'}}">
      <button class="clear-btn" bindtap="clearFilter">清除所有筛选</button>
    </view>
  </view>

  <!-- 价格筛选面板 -->
  <view class="filter-panel" wx:if="{{showFilter}}">
    <view class="filter-title">选择价格范围</view>
    
    <!-- 快速选择价格区间 -->
    <view class="price-presets">
      <view wx:for="{{pricePresets}}" wx:key="index" class="price-preset-item {{pricePresetSelected == index ? 'selected' : ''}}" bindtap="onPricePresetTap" data-index="{{index}}">
        <text>{{item.label}}</text>
      </view>
    </view>
    
    <!-- 手动输入价格范围 -->
    <view class="manual-price-input">
      <view class="input-group">
        <text class="input-label">{{listingType === 'for_sale' ? '最低价格 (£)' : '最低月租金 (£)'}}</text>
        <input type="number" class="price-input" placeholder="0" value="{{priceRange[0]}}" bindinput="onMinPriceInput" />
      </view>
      <view class="input-group">
        <text class="input-label">{{listingType === 'for_sale' ? '最高价格 (£)' : '最高月租金 (£)'}}</text>
        <input type="number" class="price-input" placeholder="{{listingType === 'for_sale' ? '2000000' : '4000'}}" value="{{priceRange[1]}}" bindinput="onMaxPriceInput" />
      </view>
    </view>
    
    <view class="price-display">
      {{priceDisplay}}
    </view>
    
    <view class="filter-actions">
      <button class="btn-primary" bindtap="applyPriceFilter">确定</button>
      <button class="btn-secondary" bindtap="cancelPriceFilter">取消</button>
    </view>
  </view>

  <!-- AI搜索结果标识栏 -->
  <view class="ai-result-bar" wx:if="{{aiFilters && searchKeyword}}">
    <text class="ai-result-label">🤖 AI生成结果</text>
    <text class="ai-result-hint">内容由AI辅助生成，请自行核实</text>
  </view>

  <!-- 房产列表 -->
  <scroll-view class="property-list" scroll-y="{{true}}" bindscrolltolower="onReachBottom">
    <view wx:for="{{properties}}" wx:key="id" class="property-item" bindtap="navigateToDetail" data-id="{{item.id}}">
      <image class="property-image" src="{{item.image_url || '/image/default_property.png'}}" mode="aspectFill" />
      <view class="property-info">
        <view class="property-title">{{item.title}}</view>
        <view class="property-price">{{item.price}}</view>
        <view class="property-meta">
          <text wx:if="{{item.bedrooms}}">{{item.bedrooms}}室</text>
          <text wx:if="{{item.property_type}}">{{item.property_type}}</text>
        </view>
        <view class="property-desc">{{item.description_chinese || item.description}}</view>
      </view>
    </view>

    <!-- 加载状态 -->
    <view wx:if="{{loading}}" class="loading">加载中...</view>
    <view wx:if="{{!hasMore && properties.length > 0}}" class="no-more">没有更多了</view>
    <view wx:if="{{properties.length === 0 && !loading}}" class="empty">暂无房产数据</view>
  </scroll-view>
</view>
